# ── Backend service ────────────────────────────────────────────────────────────
# Injected automatically by Railway; set manually for local runs
DATABASE_URL=postgresql://user:password@localhost:5432/vuln_mesh

# Anthropic API key (used by the Anthropic adapter)
ANTHROPIC_API_KEY=sk-ant-...

# API key that protects /events and /api/* endpoints.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be set on BOTH the backend service AND the frontend service so that
# nginx injects it into config.js at startup.
# Leave blank to disable auth (local dev only).
API_SECRET_KEY=

# Comma-separated list of allowed CORS origins.
# Set to the Railway frontend public URL in production.
# Use * only for local development.
CORS_ORIGINS=https://vuln-mesh-frontend.up.railway.app

# Optional: automatically start a scan when the server boots
# (leave blank to run a scan-less server that just serves the dashboard)
SCAN_TARGET=
SCAN_CONFIG=config/default.yaml

# Port — Railway injects this; leave blank for local (defaults to 8000)
PORT=8000


# ── Frontend service ───────────────────────────────────────────────────────────
# Set to the Railway backend public URL so the SPA can reach /events and /api/*
BACKEND_URL=https://vuln-mesh-backend.up.railway.app

# Port exposed by nginx inside the container
# (Railway maps this automatically; only change if you customise nginx.conf)
# PORT=80
